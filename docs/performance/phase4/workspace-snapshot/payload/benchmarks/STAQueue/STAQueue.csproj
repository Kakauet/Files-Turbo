<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsSdkPackageVersion>10.0.26100.67-preview</WindowsSdkPackageVersion>
    <Variant Condition="'$(Variant)' == ''">phase2</Variant>
    <DefineConstants Condition="'$(Variant)' == 'phase2'">$(DefineConstants);PHASE2</DefineConstants>
    <OutputPath>bin/$(Variant)/</OutputPath>
    <IntermediateOutputPath>obj/$(Variant)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../artifacts/phase2-recovery/STATask.phase1.cs" Condition="'$(Variant)' == 'phase1'" Link="STATask.cs" />
    <Compile Include="../../source/src/Files.App.Storage/Windows/Managers/STATask.cs" Condition="'$(Variant)' == 'phase2'" Link="STATask.cs" />
    <Reference Include="Files.App.CsWin32">
      <HintPath>../../source/src/Files.App.CsWin32/bin/x64/Release/net10.0-windows10.0.26100.0/win-x64/Files.App.CsWin32.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
