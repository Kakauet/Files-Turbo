<Project Sdk="Microsoft.NET.Sdk">

    <!--
        UI benchmark harness for Files, Files Turbo and Windows Explorer.
        Standalone on purpose: it is not part of Files.slnx and does not use the repository's
        central package management, so it builds with any .NET 10 SDK.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <EnableMSTestRunner>false</EnableMSTestRunner>
    </PropertyGroup>

</Project>
